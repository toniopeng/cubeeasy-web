# Public site origin for canonical, Open Graph, sitemap, and robots.
# GitHub Pages (current): https://toniopeng.github.io with VITE_BASE=/cubeeasy-web/
# Future custom domain: https://cubeeasy.app with VITE_BASE=/
# VITE_SITE_ORIGIN=https://toniopeng.github.io

# Paddle Billing (client-side only). These values are public in the built site.
# Set them in the shell or in GitHub Actions secrets named VITE_PADDLE_*.
# Never put a Paddle API key (pdl_…) here.
# VITE_PADDLE_CLIENT_TOKEN=
# VITE_PADDLE_PRICE_ID=
# VITE_PADDLE_ENV=production
